# EditorConfig — https://editorconfig.org
# Conventions for MediQueue. Severities are deliberately kept at `suggestion`:
# the build already fails on compiler warnings, and style preferences should
# guide the author rather than break the build.
root = true

# --- All files ------------------------------------------------------------
[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# --- Markup and data ------------------------------------------------------
[*.{json,yml,yaml,axaml,xaml,csproj,props,targets}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

# --- C# -------------------------------------------------------------------
[*.cs]
indent_size = 4

# Usings: System first, outside the namespace.
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:suggestion

# File-scoped namespaces — one less level of indentation in every file.
csharp_style_namespace_declarations = file_scoped:suggestion

# `var` only where the type is already apparent from the right-hand side.
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Braces are always required, including for single-statement blocks.
csharp_prefer_braces = true:suggestion

# Modern C# expression preferences.
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_style_prefer_null_check_over_type_check = true:suggestion

# Fields and locals.
dotnet_style_readonly_field = true:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

# Naming: interfaces are `IPascalCase`, private fields are `_camelCase`.
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i_pascal
dotnet_naming_rule.interfaces_start_with_i.severity = suggestion
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.prefix_i_pascal.required_prefix = I
dotnet_naming_style.prefix_i_pascal.capitalization = pascal_case

dotnet_naming_rule.private_fields_underscore.symbols = private_field_symbols
dotnet_naming_rule.private_fields_underscore.style = prefix_underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private
dotnet_naming_style.prefix_underscore_camel.required_prefix = _
dotnet_naming_style.prefix_underscore_camel.capitalization = camel_case

# --- Avalonia XAML diagnostics --------------------------------------------
# TreatWarningsAsErrors does not reach the XAML compiler: it runs as an MSBuild
# task, not as a Roslyn analyzer, so a deprecation surfaced as AVLN5001 and the
# build stayed green. The XAML compiler reads .editorconfig itself — the task is
# passed @(EditorConfigFiles) — but under its own key, not dotnet_diagnostic:
#
#     avalonia_xaml_diagnostic.<CODE>.severity = error|warning
#
# There is no wildcard, so the list below is every AVLN code Avalonia 12.1.1
# defines, promoted as a set. Enumerating them is the cost of closing the gap;
# a new code in a future Avalonia would default back to its own severity, which
# is the one thing to re-check on an upgrade.
[*.axaml]
avalonia_xaml_diagnostic.AVLN1000.severity = error
avalonia_xaml_diagnostic.AVLN1001.severity = error
avalonia_xaml_diagnostic.AVLN2000.severity = error
avalonia_xaml_diagnostic.AVLN2002.severity = error
avalonia_xaml_diagnostic.AVLN2003.severity = error
avalonia_xaml_diagnostic.AVLN2005.severity = error
avalonia_xaml_diagnostic.AVLN2100.severity = error
avalonia_xaml_diagnostic.AVLN2101.severity = error
avalonia_xaml_diagnostic.AVLN2200.severity = error
avalonia_xaml_diagnostic.AVLN2201.severity = error
avalonia_xaml_diagnostic.AVLN2202.severity = error
avalonia_xaml_diagnostic.AVLN2203.severity = error
avalonia_xaml_diagnostic.AVLN2204.severity = error
avalonia_xaml_diagnostic.AVLN2205.severity = error
avalonia_xaml_diagnostic.AVLN2206.severity = error
avalonia_xaml_diagnostic.AVLN2207.severity = error
avalonia_xaml_diagnostic.AVLN2208.severity = error
avalonia_xaml_diagnostic.AVLN3000.severity = error
avalonia_xaml_diagnostic.AVLN3001.severity = error
avalonia_xaml_diagnostic.AVLN4001.severity = error
avalonia_xaml_diagnostic.AVLN5001.severity = error
avalonia_xaml_diagnostic.AVLN9999.severity = error
