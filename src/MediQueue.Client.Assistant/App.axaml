<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MediQueue.Client.Assistant.App"
             RequestedThemeVariant="Default">
  <!--
    The template's reflection-based ViewLocator is gone: the shell has exactly
    two screens, and two explicit DataTemplates in MainWindow say which view
    belongs to which view model without a name-mangling convention in between.
  -->

  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
</Application>
