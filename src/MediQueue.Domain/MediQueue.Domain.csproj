<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The innermost layer: entities, value objects, the visit state machine and
    the business rules. It references nothing, by design — that is what makes
    the rules testable without a database, a web server or a mock.
  -->

  <PropertyGroup>
    <!--
      Warnings are already errors solution-wide, so this turns CS1591 into a
      build failure: a public member without an XML doc comment does not
      compile. "Everything public is documented" stops being a convention
      nobody checks and becomes a property of the build.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Build-time only. PrivateAssets="all" keeps the analyzer out of the
      compiled output and out of every project that references this one, so
      the layer that must depend on nothing still depends on nothing.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

</Project>
