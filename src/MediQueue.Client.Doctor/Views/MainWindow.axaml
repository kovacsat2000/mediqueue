<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MediQueue.Client.Core.ViewModels"
        xmlns:views="using:MediQueue.Client.Doctor.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="520"
        x:Class="MediQueue.Client.Doctor.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="640" Height="520"
        Title="MediQueue — Orvos">

  <!-- Which screen shows is the shell view model's decision, not the window's. -->
  <ContentControl Content="{Binding Current}">
    <ContentControl.DataTemplates>
      <DataTemplate DataType="vm:LoginViewModel">
        <views:LoginView />
      </DataTemplate>
      <DataTemplate DataType="vm:QueueViewModel">
        <views:QueueView />
      </DataTemplate>
    </ContentControl.DataTemplates>
  </ContentControl>

</Window>
