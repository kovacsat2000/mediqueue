<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MediQueue.Client.Core.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="520"
             x:Class="MediQueue.Client.Doctor.Views.QueueView"
             x:DataType="vm:QueueViewModel">

  <!--
    An ItemsControl rather than a DataGrid: DataGrid lives in a separate
    Avalonia package and needs its own theme include, which is more machinery
    than a four-column read-only list is worth.
  -->
  <DockPanel Margin="24">

    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16">
      <TextBlock Text="{Binding DoctorName}" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="Waiting list, in arrival order." Opacity="0.7" />

      <!--
        The connection state, in words. Automatic reconnect restores the socket
        but replays nothing, so a doctor is entitled to know whether the list in
        front of them is still being kept current or is a snapshot.
      -->
      <StackPanel Orientation="Horizontal" Spacing="6">
        <!-- Two ellipses rather than a value converter: one binding each, and
             nothing to register in a resource dictionary. -->
        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                 Fill="#2E7D32" IsVisible="{Binding IsLive}" />
        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                 Fill="#B3261E" IsVisible="{Binding !IsLive}" />
        <TextBlock Text="{Binding ConnectionStatus}" Opacity="0.7" FontSize="12" />
      </StackPanel>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0" Spacing="10">

      <!-- Enabled from the status the server last reported. That is
           presentation; whether a transition is legal is the server's, and its
           409 is what the doctor sees if the two ever disagree. -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Call in" Command="{Binding CallInCommand}" IsEnabled="{Binding CanCallIn}" />
        <Button Content="Record diagnosis"
                Command="{Binding RecordDiagnosisCommand}"
                IsEnabled="{Binding CanRecordDiagnosis}" />
        <Button Content="Release" Command="{Binding ReleaseCommand}" IsEnabled="{Binding CanRelease}" />
      </StackPanel>

      <!-- The detail, and the only place this application asks for it. Shown
           while the selected visit is being treated. -->
      <Border IsVisible="{Binding SelectedDetail, Converter={x:Static ObjectConverters.IsNotNull}}"
              BorderBrush="#22000000" BorderThickness="1" CornerRadius="4" Padding="12">
        <StackPanel Spacing="6" DataContext="{Binding SelectedDetail}">
          <TextBlock Text="{Binding PatientFullName}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding PatientAddress}" Opacity="0.75" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Complaint}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <TextBox PlaceholderText="Diagnosis"
               Text="{Binding DiagnosisText}"
               AcceptsReturn="True"
               Height="64"
               TextWrapping="Wrap"
               IsVisible="{Binding SelectedDetail, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <TextBlock Text="{Binding ActionError}"
                 IsVisible="{Binding ActionError, Converter={x:Static ObjectConverters.IsNotNull}}"
                 Foreground="#B3261E"
                 TextWrapping="Wrap" />

      <Button Content="Refresh"
              Command="{Binding RefreshCommand}"
              IsEnabled="{Binding !IsBusy}"
              HorizontalAlignment="Left" />
      <TextBlock Text="Loading…" IsVisible="{Binding IsBusy}" Opacity="0.7" />
      <TextBlock Text="{Binding ErrorMessage}"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                 Foreground="#B3261E"
                 TextWrapping="Wrap" />
    </StackPanel>

    <Grid RowDefinitions="Auto,*">

      <Grid Grid.Row="0" ColumnDefinitions="80,*,140,110" Margin="0,0,0,6">
        <TextBlock Grid.Column="0" Text="Time" FontWeight="SemiBold" Opacity="0.7" />
        <TextBlock Grid.Column="1" Text="Patient" FontWeight="SemiBold" Opacity="0.7" />
        <TextBlock Grid.Column="2" Text="TAJ" FontWeight="SemiBold" Opacity="0.7" />
        <TextBlock Grid.Column="3" Text="Status" FontWeight="SemiBold" Opacity="0.7" />
      </Grid>

      <Grid Grid.Row="1">
        <!-- An empty queue says so, rather than showing a blank rectangle that
             looks like a failure. -->
        <TextBlock Text="Nobody is waiting."
                   IsVisible="{Binding IsEmpty}"
                   Opacity="0.6"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

        <!-- A ListBox rather than an ItemsControl now: the doctor acts on the
             selected patient, so the list has to have a selection. -->
        <ListBox IsVisible="{Binding !IsEmpty}"
                 ItemsSource="{Binding Rows}"
                 SelectedItem="{Binding SelectedRow}"
                 Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:QueueRow">
              <Grid ColumnDefinitions="80,*,140,110">
                <TextBlock Grid.Column="0" Text="{Binding QueuedAtDisplay}" FontFamily="monospace" />
                <TextBlock Grid.Column="1" Text="{Binding PatientFullName}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding Taj}" FontFamily="monospace" />
                <TextBlock Grid.Column="3" Text="{Binding StatusDisplay}" Opacity="0.8" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

    </Grid>

  </DockPanel>

</UserControl>
