<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The one test project that starts a UI framework.

    It exists to prove the last link in the push chain: that a callback arriving
    on a background thread reaches a control Avalonia is actually binding to,
    without a cross-thread exception. Everything below that link is covered
    without a window, and MediQueue.Client.Core.Tests must stay that way — so
    this is a separate project rather than a package added to that one.

    Avalonia.Headless only. The Avalonia.Headless.XUnit integration would be
    more ergonomic and it depends on xunit.v3, which this solution deliberately
    does not use (a second test framework in one solution costs more than the
    attribute saves). HeadlessUnitTestSession is the same mechanism that
    attribute wraps, and it is public.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <!-- Matching the other test projects, so a test file reads the same here. -->
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The doctor shell, for its AvaloniaUiDispatcher. Testing a copy of that one
      line would prove the copy works; the open question is whether the
      dispatcher the shells actually nominate is the one Avalonia requires.
    -->
    <ProjectReference Include="..\..\src\MediQueue.Client.Doctor\MediQueue.Client.Doctor.csproj" />
    <ProjectReference Include="..\..\src\MediQueue.Client.Core\MediQueue.Client.Core.csproj" />
  </ItemGroup>

</Project>
