<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    <clear/> drops any package source inherited from the machine or user
    NuGet.config, so the build resolves identically on a developer machine
    and on a CI runner. It also satisfies NU1507, which requires central
    package management to resolve from a single, unambiguous source.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

</configuration>
