<Project>

  <!--
    Central Package Management: every package version in the solution is
    declared here exactly once. Project files reference packages by id only.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Build-time only. Contributes nothing to any compiled output. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
  </ItemGroup>

  <!-- Persistence -->
  <ItemGroup>
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- JWT bearer issuance and validation. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <!-- PasswordHasher<T> only. The full ASP.NET Core Identity stack is not used. -->
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.10" />
  </ItemGroup>

  <!-- API -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.17" />
    <!-- Reports whether the API can actually reach the database. -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.10" />
    <!--
      Serilog.AspNetCore is a curated meta-package: it pins Serilog itself and
      the Console, Debug and File sinks. Referencing a sink separately would
      mean keeping a second version in lockstep with Serilog's own pin, and a
      mismatch surfaces as NU1605 — a build failure here.
    -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <!--
    Transitive pins. Microsoft.AspNetCore.OpenApi 10.0.10 resolves
    Microsoft.OpenApi 2.0.0, which carries GHSA-v5pm-xwqc-g5wc (high:
    circular schema references can terminate OpenAPI parsing). 2.7.5 is the
    first patched version named in the advisory. Remove this pin once the
    ASP.NET Core package ships a patched dependency of its own.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
  </ItemGroup>

  <!--
    Npgsql 10.0.3 declares Entity Framework Core 10.0.4, while
    EntityFrameworkCore.Design resolves 10.0.10. Because Design is
    PrivateAssets="all" it does not flow to the API project, so Infrastructure
    compiled against 10.0.10 while the API resolved 10.0.4 — which surfaces as
    CS1705 and MSB3277, and is a build failure here. Pinning the family to one
    version is the fix; 10.0.10 is the newest patch and satisfies both.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Analyzers" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
  </ItemGroup>

  <!-- Desktop clients -->
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Composition root of the desktop shells: DI, typed HttpClient, config. -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
  </ItemGroup>

  <!-- Tests -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.8.0" />
    <PackageVersion Include="NSubstitute" Version="6.0.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>